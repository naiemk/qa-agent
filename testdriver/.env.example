# GitHub App (days 0–2 private dogfood)
APP_ID=
WEBHOOK_SECRET=
# Prefer a file path; do not commit the PEM
PRIVATE_KEY_PATH=./secrets/app.private-key.pem
# Or paste PEM (escaped newlines) — avoid in shared shells
# PRIVATE_KEY=

# Mention handle without the @ (default: magpi-test)
MENTION_HANDLE=magpi-test

# Magpi Test CLI boundary (subprocess only)
# Default resolves to ../bin/magpi-test.mjs from the repo root
MAGPI_TEST_BIN=
# Optional fixed checkout for dogfood when not cloning per install
MAGPI_TEST_WORKDIR=
JOB_MAX_MINUTES=30

# Passed through to Magpi Test for live runs
OPENROUTER_API_KEY=

# HTTP
PORT=3000
# Optional: smee.io proxy URL for local webhook delivery
WEBHOOK_PROXY_URL=
