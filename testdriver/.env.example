# GitHub App (days 0–2 private dogfood)
APP_ID=
WEBHOOK_SECRET=
# Prefer a file path; do not commit the PEM
PRIVATE_KEY_PATH=./secrets/app.private-key.pem
# Or paste PEM with literal \n escapes
# PRIVATE_KEY=

# Phrase that triggers a job in issue/PR comment bodies (with or without leading @)
TRIGGER_PHRASE=@magpi-test

# Magpi Test CLI boundary (subprocess spawn)
# Default resolves to ../bin/magpi-test.mjs from the repo root
MAGPI_TEST_BIN=
# Optional default preview URL when the comment omits one
MAGPI_TEST_BASE_URL=
# Required for dogfood until PR checkout/clone lands: absolute path to target app
MAGPI_TEST_WORKDIR=
JOB_MAX_MINUTES=30

# Passed through to Magpi Test child process
OPENROUTER_API_KEY=

# HTTP
PORT=3000
# Optional: smee.io / tunnel URL for local webhook delivery
WEBHOOK_PROXY_URL=
